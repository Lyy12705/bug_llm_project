{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/assignee/assignee_eligibility_review.schema.json",
  "title": "Reviewed assignee capability and permission attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "review_confirmed",
    "reviewer",
    "valid_from",
    "expires_at",
    "assignees"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "review_confirmed": {"const": true},
    "reviewer": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "assignees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignee",
          "eligible",
          "permissions_confirmed"
        ],
        "properties": {
          "assignee": {"type": "string", "minLength": 1},
          "eligible": {"type": "boolean"},
          "permissions_confirmed": {"type": "boolean"},
          "eligible_products": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "eligible_components": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "eligible_product_components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["product", "component"],
              "properties": {
                "product": {"type": "string", "minLength": 1},
                "component": {"type": "string", "minLength": 1}
              }
            },
            "uniqueItems": true
          }
        },
        "anyOf": [
          {"required": ["eligible_products"]},
          {"required": ["eligible_components"]},
          {"required": ["eligible_product_components"]}
        ]
      }
    }
  }
}
